# Copy to .env for Compose. For native scripts: set -a; source .env; set +a
# Replace with absolute paths. Workbook paths must match paths inside the runtime.
HISTOLOOP_DATA_ROOT=/path/to/prepared-data
HISTOLOOP_STATE_DIR=/path/to/annotations
HISTOLOOP_PORT=8765
HISTOLOOP_UID=10001
HISTOLOOP_GID=10001
# Native defaults: loopback binding, CPU review, compute disabled.
# HISTOLOOP_PYTHON=/path/to/python
# HISTOLOOP_CACHE_DIR=/node/local/scratch/histoloop
# HISTOLOOP_DATASETS_FILE=/path/to/prepared-data/datasets.json
# HISTOLOOP_ORIGINAL_MANIFEST=/path/to/prepared-data/case_split.xlsx
# Optional native GPU workers only (a model-compatible RAPIDS environment is required).
# HISTOLOOP_ENABLE_COMPUTE=1
# HISTOLOOP_WORKER_PYTHON=/path/to/rapids-env/bin/python
# HISTOLOOP_BASELINE_MODEL=/path/to/model/svc_pipeline.pkl
# HISTOLOOP_ORIGINAL_FEATURES=/path/to/original/features
# HISTOLOOP_ACCOUNT=your_account
# HISTOLOOP_QOS=your_qos
# HISTOLOOP_GPU_PARTITION=your_gpu_partition
# HISTOLOOP_GPU_RESOURCE=gpu:l4:1
